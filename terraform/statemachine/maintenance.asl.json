{
    "Comment": "Automated Windows EC2 maintenance workflow",
    "StartAt": "MaintenanceWorkflow",
    "States": {
        "MaintenanceWorkflow": {
            "Type": "Parallel",
            "Branches": [
                {
                    "StartAt": "StopInstance",
                    "States": {
                        "StopInstance": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ec2:stopInstances",
                            "Parameters": {
                                "InstanceIds": [
                                    "${instance_id}"
                                ]
                            },
                            "Next": "WaitForStopped"
                        },
                        "WaitForStopped": {
                            "Type": "Wait",
                            "Seconds": 15,
                            "Next": "CheckStopped"
                        },
                        "CheckStopped": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
                            "Parameters": {
                                "InstanceIds": [
                                    "${instance_id}"
                                ]
                            },
                            "ResultPath": "$.InstanceStatus",
                            "Next": "IsStopped"
                        },
                        "IsStopped": {
                            "Type": "Choice",
                            "Choices": [
                                {
                                    "Variable": "$.InstanceStatus.Reservations[0].Instances[0].State.Name",
                                    "StringEquals": "stopped",
                                    "Next": "DescribeVolumes"
                                }
                            ],
                            "Default": "WaitForStopped"
                        },
                        "DescribeVolumes": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ec2:describeVolumes",
                            "Parameters": {
                                "Filters": [
                                    {
                                        "Name": "attachment.instance-id",
                                        "Values": [
                                            "${instance_id}"
                                        ]
                                    }
                                ]
                            },
                            "ResultPath": "$.VolumeInfo",
                            "Next": "CreateSnapshots"
                        },
                        "CreateSnapshots": {
                            "Type": "Map",
                            "ItemsPath": "$.VolumeInfo.Volumes",
                            "ResultPath": "$.Snapshots",
                            "ItemProcessor": {
                                "ProcessorConfig": {
                                    "Mode": "INLINE"
                                },
                                "StartAt": "CreateSnapshot",
                                "States": {
                                    "CreateSnapshot": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::aws-sdk:ec2:createSnapshot",
                                        "Parameters": {
                                            "VolumeId.$": "$.VolumeId",
                                            "Description": "Pre-maintenance snapshot created by Step Functions"
                                        },
                                        "ResultPath": "$.Snapshot",
                                        "Next": "WaitForSnapshot"
                                    },
                                    "WaitForSnapshot": {
                                        "Type": "Wait",
                                        "Seconds": 20,
                                        "Next": "CheckSnapshot"
                                    },
                                    "CheckSnapshot": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::aws-sdk:ec2:describeSnapshots",
                                        "Parameters": {
                                            "SnapshotIds.$": "States.Array($.Snapshot.SnapshotId)"
                                        },
                                        "ResultPath": "$.SnapshotStatus",
                                        "Next": "IsSnapshotComplete"
                                    },
                                    "IsSnapshotComplete": {
                                        "Type": "Choice",
                                        "Choices": [
                                            {
                                                "Variable": "$.SnapshotStatus.Snapshots[0].State",
                                                "StringEquals": "completed",
                                                "Next": "SnapshotComplete"
                                            },
                                            {
                                                "Variable": "$.SnapshotStatus.Snapshots[0].State",
                                                "StringEquals": "error",
                                                "Next": "SnapshotFailed"
                                            }
                                        ],
                                        "Default": "WaitForSnapshot"
                                    },
                                    "SnapshotComplete": {
                                        "Type": "Succeed"
                                    },
                                    "SnapshotFailed": {
                                        "Type": "Fail",
                                        "Error": "SnapshotFailed",
                                        "Cause": "EBS snapshot creation failed"
                                    }
                                }
                            },
                            "Next": "StartInstance"
                        },
                        "StartInstance": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ec2:startInstances",
                            "Parameters": {
                                "InstanceIds": [
                                    "${instance_id}"
                                ]
                            },
                            "Next": "WaitForRunning"
                        },
                        "WaitForRunning": {
                            "Type": "Wait",
                            "Seconds": 15,
                            "Next": "CheckRunning"
                        },
                        "CheckRunning": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
                            "Parameters": {
                                "InstanceIds": [
                                    "${instance_id}"
                                ]
                            },
                            "ResultPath": "$.InstanceStatus",
                            "Next": "IsRunning"
                        },
                        "IsRunning": {
                            "Type": "Choice",
                            "Choices": [
                                {
                                    "Variable": "$.InstanceStatus.Reservations[0].Instances[0].State.Name",
                                    "StringEquals": "running",
                                    "Next": "WaitForSSM"
                                }
                            ],
                            "Default": "WaitForRunning"
                        },
                        "WaitForSSM": {
                            "Type": "Wait",
                            "Seconds": 20,
                            "Next": "CheckSSMOnline"
                        },
                        "CheckSSMOnline": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ssm:describeInstanceInformation",
                            "Parameters": {
                                "Filters": [
                                    {
                                        "Key": "InstanceIds",
                                        "Values": [
                                            "${instance_id}"
                                        ]
                                    }
                                ]
                            },
                            "ResultPath": "$.SSMStatus",
                            "Next": "IsSSMOnline"
                        },
                        "IsSSMOnline": {
                            "Type": "Choice",
                            "Choices": [
                                {
                                    "And": [
                                        {
                                            "Variable": "$.SSMStatus.InstanceInformationList[0].PingStatus",
                                            "StringEquals": "Online"
                                        }
                                    ],
                                    "Next": "RunWindowsUpdate"
                                }
                            ],
                            "Default": "WaitForSSM"
                        },
                        "RunWindowsUpdate": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
                            "Parameters": {
                                "DocumentName": "AWS-RunPatchBaseline",
                                "InstanceIds": [
                                    "${instance_id}"
                                ],
                                "Parameters": {
                                    "Operation": [
                                        "Install"
                                    ],
                                    "RebootOption": [
                                        "RebootIfNeeded"
                                    ]
                                },
                                "CloudWatchOutputConfig": {
                                    "CloudWatchOutputEnabled": true,
                                    "CloudWatchLogGroupName": "/aws/ssm/windows-maintenance"
                                }
                            },
                            "ResultPath": "$.PatchCommand",
                            "Next": "WaitForPatch"
                        },
                        "WaitForPatch": {
                            "Type": "Wait",
                            "Seconds": 30,
                            "Next": "CheckPatchStatus"
                        },
                        "CheckPatchStatus": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ssm:getCommandInvocation",
                            "Parameters": {
                                "CommandId.$": "$.PatchCommand.Command.CommandId",
                                "InstanceId": "${instance_id}"
                            },
                            "ResultPath": "$.PatchStatus",
                            "Retry": [
                                {
                                    "ErrorEquals": [
                                        "States.ALL"
                                    ],
                                    "IntervalSeconds": 10,
                                    "MaxAttempts": 6,
                                    "BackoffRate": 1.5
                                }
                            ],
                            "Next": "IsPatchComplete"
                        },
                        "IsPatchComplete": {
                            "Type": "Choice",
                            "Choices": [
                                {
                                    "Variable": "$.PatchStatus.Status",
                                    "StringEquals": "Success",
                                    "Next": "PatchComplete"
                                },
                                {
                                    "Variable": "$.PatchStatus.Status",
                                    "StringEquals": "Failed",
                                    "Next": "PatchFailed"
                                },
                                {
                                    "Variable": "$.PatchStatus.Status",
                                    "StringEquals": "TimedOut",
                                    "Next": "PatchFailed"
                                },
                                {
                                    "Variable": "$.PatchStatus.Status",
                                    "StringEquals": "Cancelled",
                                    "Next": "PatchFailed"
                                }
                            ],
                            "Default": "WaitForPatch"
                        },
                        "PatchComplete": {
                            "Type": "Pass",
                            "Parameters": {
                                "count": 0
                            },
                            "ResultPath": "$.PostPatchSSMRetry",
                            "Next": "WaitForPostPatchSSM"
                        },
                        "WaitForPostPatchSSM": {
                            "Type": "Wait",
                            "Seconds": 20,
                            "Next": "CheckPostPatchSSM"
                        },
                        "CheckPostPatchSSM": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ssm:describeInstanceInformation",
                            "Parameters": {
                                "Filters": [
                                    {
                                        "Key": "InstanceIds",
                                        "Values": [
                                            "${instance_id}"
                                        ]
                                    }
                                ]
                            },
                            "ResultPath": "$.PostPatchSSMStatus",
                            "Next": "IsPostPatchSSMOnline"
                        },
                        "IsPostPatchSSMOnline": {
                            "Type": "Choice",
                            "Choices": [
                                {
                                    "And": [
                                        {
                                            "Variable": "$.PostPatchSSMStatus.InstanceInformationList[0].PingStatus",
                                            "IsPresent": true
                                        },
                                        {
                                            "Variable": "$.PostPatchSSMStatus.InstanceInformationList[0].PingStatus",
                                            "StringEquals": "Online"
                                        }
                                    ],
                                    "Next": "RunHealthCheck"
                                }
                            ],
                            "Default": "CheckPostPatchSSMRetry"
                        },
                        "CheckPostPatchSSMRetry": {
                            "Type": "Choice",
                            "Choices": [
                                {
                                    "Variable": "$.PostPatchSSMRetry.count",
                                    "NumericGreaterThanEquals": 9,
                                    "Next": "PostPatchSSMTimeout"
                                }
                            ],
                            "Default": "IncrementPostPatchSSMRetry"
                        },
                        "IncrementPostPatchSSMRetry": {
                            "Type": "Pass",
                            "Parameters": {
                                "count.$": "States.MathAdd($.PostPatchSSMRetry.count, 1)"
                            },
                            "ResultPath": "$.PostPatchSSMRetry",
                            "Next": "WaitForPostPatchSSM"
                        },
                        "PostPatchSSMTimeout": {
                            "Type": "Fail",
                            "Error": "PostPatchSSMTimeout",
                            "Cause": "SSM did not return Online after Windows patching and reboot."
                        },
                        "RunHealthCheck": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
                            "Parameters": {
                                "DocumentName": "AWS-RunPowerShellScript",
                                "InstanceIds": [
                                    "${instance_id}"
                                ],
                                "Parameters": {
                                    "commands": [
                                        "$ErrorActionPreference = 'Stop'",
                                        "$service = Get-Service -Name 'Winmgmt'",
                                        "if ($service.Status -ne 'Running') { throw 'Winmgmt service is not running.' }",
                                        "Get-HotFix | Sort-Object InstalledOn -Descending | Select-Object -First 5"
                                    ]
                                },
                                "CloudWatchOutputConfig": {
                                    "CloudWatchOutputEnabled": true,
                                    "CloudWatchLogGroupName": "/aws/ssm/windows-maintenance"
                                }
                            },
                            "ResultPath": "$.HealthCommand",
                            "Next": "WaitForHealthCheck"
                        },
                        "WaitForHealthCheck": {
                            "Type": "Wait",
                            "Seconds": 15,
                            "Next": "CheckHealthStatus"
                        },
                        "CheckHealthStatus": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ssm:getCommandInvocation",
                            "Parameters": {
                                "CommandId.$": "$.HealthCommand.Command.CommandId",
                                "InstanceId": "${instance_id}"
                            },
                            "ResultPath": "$.HealthStatus",
                            "Next": "IsHealthy"
                        },
                        "IsHealthy": {
                            "Type": "Choice",
                            "Choices": [
                                {
                                    "Variable": "$.HealthStatus.Status",
                                    "StringEquals": "Success",
                                    "Next": "HealthCheckComplete"
                                },
                                {
                                    "Variable": "$.HealthStatus.Status",
                                    "StringEquals": "Failed",
                                    "Next": "HealthCheckFailed"
                                }
                            ],
                            "Default": "WaitForHealthCheck"
                        },
                        "HealthCheckComplete": {
                            "Type": "Pass",
                            "Next": "StopForPostSnapshot"
                        },
                        "StopForPostSnapshot": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ec2:stopInstances",
                            "Parameters": {
                                "InstanceIds": [
                                    "${instance_id}"
                                ]
                            },
                            "Next": "WaitForPostStopped"
                        },
                        "WaitForPostStopped": {
                            "Type": "Wait",
                            "Seconds": 15,
                            "Next": "CheckPostStopped"
                        },
                        "CheckPostStopped": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
                            "Parameters": {
                                "InstanceIds": [
                                    "${instance_id}"
                                ]
                            },
                            "ResultPath": "$.PostInstanceStatus",
                            "Next": "IsPostStopped"
                        },
                        "IsPostStopped": {
                            "Type": "Choice",
                            "Choices": [
                                {
                                    "Variable": "$.PostInstanceStatus.Reservations[0].Instances[0].State.Name",
                                    "StringEquals": "stopped",
                                    "Next": "DescribePostVolumes"
                                }
                            ],
                            "Default": "WaitForPostStopped"
                        },
                        "DescribePostVolumes": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ec2:describeVolumes",
                            "Parameters": {
                                "Filters": [
                                    {
                                        "Name": "attachment.instance-id",
                                        "Values": [
                                            "${instance_id}"
                                        ]
                                    }
                                ]
                            },
                            "ResultPath": "$.PostVolumeInfo",
                            "Next": "CreatePostSnapshots"
                        },
                        "CreatePostSnapshots": {
                            "Type": "Map",
                            "ItemsPath": "$.PostVolumeInfo.Volumes",
                            "ResultPath": "$.PostSnapshots",
                            "ItemProcessor": {
                                "ProcessorConfig": {
                                    "Mode": "INLINE"
                                },
                                "StartAt": "CreatePostSnapshot",
                                "States": {
                                    "CreatePostSnapshot": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::aws-sdk:ec2:createSnapshot",
                                        "Parameters": {
                                            "VolumeId.$": "$.VolumeId",
                                            "Description": "Post-maintenance snapshot created by Step Functions"
                                        },
                                        "ResultPath": "$.Snapshot",
                                        "Next": "WaitForPostSnapshot"
                                    },
                                    "WaitForPostSnapshot": {
                                        "Type": "Wait",
                                        "Seconds": 20,
                                        "Next": "CheckPostSnapshot"
                                    },
                                    "CheckPostSnapshot": {
                                        "Type": "Task",
                                        "Resource": "arn:aws:states:::aws-sdk:ec2:describeSnapshots",
                                        "Parameters": {
                                            "SnapshotIds.$": "States.Array($.Snapshot.SnapshotId)"
                                        },
                                        "ResultPath": "$.SnapshotStatus",
                                        "Next": "IsPostSnapshotComplete"
                                    },
                                    "IsPostSnapshotComplete": {
                                        "Type": "Choice",
                                        "Choices": [
                                            {
                                                "Variable": "$.SnapshotStatus.Snapshots[0].State",
                                                "StringEquals": "completed",
                                                "Next": "PostSnapshotComplete"
                                            },
                                            {
                                                "Variable": "$.SnapshotStatus.Snapshots[0].State",
                                                "StringEquals": "error",
                                                "Next": "PostSnapshotFailed"
                                            }
                                        ],
                                        "Default": "WaitForPostSnapshot"
                                    },
                                    "PostSnapshotComplete": {
                                        "Type": "Succeed"
                                    },
                                    "PostSnapshotFailed": {
                                        "Type": "Fail",
                                        "Error": "PostSnapshotFailed",
                                        "Cause": "Post-maintenance EBS snapshot creation failed"
                                    }
                                }
                            },
                            "Next": "StartAfterPostSnapshot"
                        },
                        "StartAfterPostSnapshot": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ec2:startInstances",
                            "Parameters": {
                                "InstanceIds": [
                                    "${instance_id}"
                                ]
                            },
                            "Next": "WaitForFinalRunning"
                        },
                        "WaitForFinalRunning": {
                            "Type": "Wait",
                            "Seconds": 15,
                            "Next": "CheckFinalRunning"
                        },
                        "CheckFinalRunning": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ec2:describeInstances",
                            "Parameters": {
                                "InstanceIds": [
                                    "${instance_id}"
                                ]
                            },
                            "ResultPath": "$.FinalInstanceStatus",
                            "Next": "IsFinalRunning"
                        },
                        "IsFinalRunning": {
                            "Type": "Choice",
                            "Choices": [
                                {
                                    "Variable": "$.FinalInstanceStatus.Reservations[0].Instances[0].State.Name",
                                    "StringEquals": "running",
                                    "Next": "WaitForFinalSSM"
                                }
                            ],
                            "Default": "WaitForFinalRunning"
                        },
                        "WaitForFinalSSM": {
                            "Type": "Wait",
                            "Seconds": 20,
                            "Next": "CheckFinalSSMOnline"
                        },
                        "CheckFinalSSMOnline": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ssm:describeInstanceInformation",
                            "Parameters": {
                                "Filters": [
                                    {
                                        "Key": "InstanceIds",
                                        "Values": [
                                            "${instance_id}"
                                        ]
                                    }
                                ]
                            },
                            "ResultPath": "$.FinalSSMStatus",
                            "Next": "IsFinalSSMOnline"
                        },
                        "IsFinalSSMOnline": {
                            "Type": "Choice",
                            "Choices": [
                                {
                                    "Variable": "$.FinalSSMStatus.InstanceInformationList[0].PingStatus",
                                    "StringEquals": "Online",
                                    "Next": "RunFinalHealthCheck"
                                }
                            ],
                            "Default": "WaitForFinalSSM"
                        },
                        "RunFinalHealthCheck": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
                            "Parameters": {
                                "DocumentName": "AWS-RunPowerShellScript",
                                "InstanceIds": [
                                    "${instance_id}"
                                ],
                                "Parameters": {
                                    "commands": [
                                        "$ErrorActionPreference = 'Stop'",
                                        "$service = Get-Service -Name 'Winmgmt'",
                                        "if ($service.Status -ne 'Running') { throw 'Winmgmt service is not running.' }",
                                        "Get-HotFix | Sort-Object InstalledOn -Descending | Select-Object -First 5"
                                    ]
                                }
                            },
                            "ResultPath": "$.FinalHealthCommand",
                            "Next": "WaitForFinalHealthCheck"
                        },
                        "WaitForFinalHealthCheck": {
                            "Type": "Wait",
                            "Seconds": 15,
                            "Next": "CheckFinalHealthStatus"
                        },
                        "CheckFinalHealthStatus": {
                            "Type": "Task",
                            "Resource": "arn:aws:states:::aws-sdk:ssm:getCommandInvocation",
                            "Parameters": {
                                "CommandId.$": "$.FinalHealthCommand.Command.CommandId",
                                "InstanceId": "${instance_id}"
                            },
                            "ResultPath": "$.FinalHealthStatus",
                            "Retry": [
                                {
                                    "ErrorEquals": [
                                        "States.ALL"
                                    ],
                                    "IntervalSeconds": 10,
                                    "MaxAttempts": 6,
                                    "BackoffRate": 1.5
                                }
                            ],
                            "Next": "IsFinalHealthy"
                        },
                        "IsFinalHealthy": {
                            "Type": "Choice",
                            "Choices": [
                                {
                                    "Variable": "$.FinalHealthStatus.Status",
                                    "StringEquals": "Success",
                                    "Next": "FinalHealthCheckComplete"
                                },
                                {
                                    "Variable": "$.FinalHealthStatus.Status",
                                    "StringEquals": "Failed",
                                    "Next": "FinalHealthCheckFailed"
                                }
                            ],
                            "Default": "WaitForFinalHealthCheck"
                        },
                        "FinalHealthCheckComplete": {
                            "Type": "Succeed"
                        },
                        "FinalHealthCheckFailed": {
                            "Type": "Fail",
                            "Error": "FinalHealthCheckFailed",
                            "Cause": "Final Windows health check failed"
                        },
                        "HealthCheckFailed": {
                            "Type": "Fail",
                            "Error": "HealthCheckFailed",
                            "Cause": "Post-patch Windows health check failed"
                        },
                        "PatchFailed": {
                            "Type": "Fail",
                            "Error": "WindowsPatchFailed",
                            "Cause": "AWS-RunPatchBaseline failed"
                        }
                    }
                }
            ],
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "ResultPath": "$.error",
                    "Next": "NotifyFailure"
                }
            ],
            "Next": "NotifySuccess"
        },
        "NotifySuccess": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sns:publish",
            "Parameters": {
                "TopicArn": "${sns_topic_arn}",
                "Subject": "Windows Maintenance Successful",
                "Message": "Windows maintenance Phase 1 completed successfully. The instance was stopped, EBS snapshots were completed, and the instance was started again."
            },
            "End": true
        },
        "NotifyFailure": {
            "Type": "Task",
            "Resource": "arn:aws:states:::sns:publish",
            "Parameters": {
                "TopicArn": "${sns_topic_arn}",
                "Subject": "Windows Maintenance Failed",
                "Message.$": "States.Format('Windows maintenance failed. Cause: {}', $.error.Cause)"
            },
            "End": true
        }
    }
}